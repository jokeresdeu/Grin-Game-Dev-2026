      value: 
      objectReference: {fileID: 1896665799}
    - target: {fileID: 5058338361071753448, guid: d68eb0eaef931e046a7a3aa5020412af, type: 3}
      propertyPath: _dialoguePanel
      value: 
      objectReference: {fileID: 296113867}
    - target: {fileID: 5058338361071753448, guid: d68eb0eaef931e046a7a3aa5020412af, type: 3}
      propertyPath: _interactRange
      value: 9.25
      objectReference: {fileID: 0}
    - target: {fileID: 5058338361071753448, guid: d68eb0eaef931e046a7a3aa5020412af, type: 3}
      propertyPath: _interactPrompt
      value: 
      objectReference: {fileID: 24028475}
    - target: {fileID: 5058338361071753448, guid: d68eb0eaef931e046a7a3aa5020412af, type: 3}
      propertyPath: _dialogueLines.Array.size
      value: 3
      objectReference: {fileID: 0}
    - target: {fileID: 5058338361071753448, guid: d68eb0eaef931e046a7a3aa5020412af, type: 3}
      propertyPath: '_dialogueLines.Array.data[0]'
      value: "\u0413\u0435\u0439, \u0448\u0443\u043A\u0430\u0447\u0443 \u043F\u0440\u0438\u0433\u043E\u0434!
        \u0422\u0438 \u043D\u0435 \u043C\u043E\u0436\u0435\u0448 \u043F\u0440\u043E\u0441\u0442\u043E
        \u043F\u0456\u0442\u0438 \u0434\u0430\u043B\u0456. \u041B\u0438\u0448\u0435
        \u0441\u0438\u043B\u044C\u043D\u0456 \u0442\u0430 \u0433\u0456\u0434\u043D\u0456
        \u0437\u043C\u043E\u0436\u0443\u0442\u044C \u043F\u0440\u043E\u0439\u0442\u0438."
      objectReference: {fileID: 0}
    - target: {fileID: 5058338361071753448, guid: d68eb0eaef931e046a7a3aa5020412af, type: 3}
      propertyPath: '_dialogueLines.Array.data[1]'
      value: "\u041F\u043E\u043F\u0435\u0440\u0435\u0434\u0443 \u043C\u0456\u0439
        \u0431\u0430\u0442\u044C\u043A\u043E, \u044F\u043A\u0438\u0439 \u0432\u0438\u043F\u0440\u043E\u0431\u0443\u0454
        \u0442\u0435\u0431\u0435. \u0412\u0456\u043D \u0432\u0438\u0440\u0456\u0448\u0438\u0442\u044C,
        \u0447\u0438 \u0433\u0456\u0434\u043D\u0438\u0439 \u0442\u0438. \u042F\u043A\u0449\u043E
        \u0445\u043E\u0447\u0435\u0448 \u0440\u0443\u0445\u0430\u0442\u0438\u0441\u044F
        \u0434\u0430\u043B\u0456, \u0442\u043E\u0431\u0456 \u0434\u043E\u0432\u0435\u0434\u0435\u0442\u044C\u0441\u044F
        \u0431\u0438\u0442\u0438\u0441\u044F \u0437 \u043D\u0438\u043C!"
      objectReference: {fileID: 0}
    - target: {fileID: 5058338361071753448, guid: d68eb0eaef931e046a7a3aa5020412af, type: 3}
      propertyPath: '_dialogueLines.Array.data[2]'
      value: "\u041C\u043E\u0436\u0435\u0448 \u0441\u043F\u0440\u043E\u0431\u0443\u0432\u0430\u0442\u0438
        \u043A\u0438\u043D\u0443\u0442\u0438 \u043C\u0435\u043D\u0456 \u0432\u0438\u043A\u043B\u0438\u043A\u2026
        \u0430\u043B\u0435 \u044F \u0431 \u0434\u043E\u0431\u0440\u0435 \u043F\u043E\u0434\u0443\u043C\u0430\u0432
        \u043D\u0430 \u0442\u0432\u043E\u0454\u043C\u0443 \u043C\u0456\u0441\u0446\u0456.
        \u041F\u043E\u0432\u0456\u0440, \u0446\u0435 \u0437\u0430\u043A\u0456\u043D\u0447\u0438\u0442\u044C\u0441\u044F
        \u0434\u043B\u044F \u0442\u0435\u0431\u0435 \u043D\u0435 \u0442\u0430\u043A,
        \u044F\u043A \u0442\u0438 \u0441\u043F\u043E\u0434\u0456\u0432\u0430\u0454\u0448\u0441\u044F\u2026
        \u0445\u0435-\u0445\u0435-\u0445\u0435 "
      objectReference: {fileID: 0}
    - target: {fileID: 5260579870080951921, guid: d68eb0eaef931e046a7a3aa5020412af, type: 3}
      propertyPath: m_LocalPosition.x
